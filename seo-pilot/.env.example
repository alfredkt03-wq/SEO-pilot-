# Copy this file to `.env` and fill in the values.
#
# Local development: `npm run dev` (the Shopify CLI) supplies SHOPIFY_API_KEY,
# SHOPIFY_API_SECRET, SCOPES and the tunnel URL automatically, so DATABASE_URL
# is the only value you must set yourself.
#
# Production (Render): set all of these in the Render dashboard's Environment
# tab instead — never commit real values to a file.

# Neon Postgres connection string. Use the DIRECT (unpooled) one — in Neon's
# connection dialog, turn "Connection pooling" OFF, so the host has no
# "-pooler" in it. The app runs as a single long-lived server that needs only
# a handful of connections, and Prisma's migrations can fail against a pooled
# connection.
DATABASE_URL=

# Only needed in production — locally the Shopify CLI provides these.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_products,write_content,write_online_store_navigation,write_files
SHOPIFY_APP_URL=

# AI writing (titles, meta descriptions, alt text, Pro descriptions).
# Create a key at console.anthropic.com and add a little credit. Optional —
# without it the app works and simply hides the AI buttons.
ANTHROPIC_API_KEY=

# Optional: a free Google API key with the PageSpeed Insights API enabled, for
# reliable quota on the mobile speed test. Works without one for light use.
PAGESPEED_API_KEY=

# Google Search Console (Premium/Exclusive feature). Create an OAuth 2.0 Web
# Client in a Google Cloud project with the "Search Console API" enabled at
# console.cloud.google.com, and add this exact redirect URI to it:
#   <SHOPIFY_APP_URL>/auth/gsc/callback
# Optional — without these, the Search Console page just says it's not set
# up yet; nothing else in the app is affected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
