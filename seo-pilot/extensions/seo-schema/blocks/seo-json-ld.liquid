{%- comment -%}
  SEO Pilot — structured data (JSON-LD)

  App embed block, injected once before </head> on every storefront page
  once the merchant turns it on in Theme Editor > App embeds. Outputs
  schema.org markup so Google can show richer results: organization/brand
  info, local business details, product price & availability, blog posts,
  and breadcrumbs.

  Every value that comes from shop data is passed through the `json` filter
  rather than hand-quoted, so quotes/backslashes/unicode in a title or
  description can never produce invalid JSON.
{%- endcomment -%}

{%- comment -%}
  Noindex — set from the app's manual editor (product/page/collection), saved
  as a seo_pilot.noindex metafield. Checked on whichever object matches the
  current template; anything else (cart, search, 404, etc.) is unaffected.
{%- endcomment -%}
{%- assign seo_pilot_noindex = false -%}
{%- if template contains 'product' and product and product.metafields.seo_pilot.noindex == true -%}
  {%- assign seo_pilot_noindex = true -%}
{%- elsif template contains 'page' and page and page.metafields.seo_pilot.noindex == true -%}
  {%- assign seo_pilot_noindex = true -%}
{%- elsif template contains 'collection' and collection and collection.metafields.seo_pilot.noindex == true -%}
  {%- assign seo_pilot_noindex = true -%}
{%- endif -%}
{%- if seo_pilot_noindex -%}
  <meta name="robots" content="noindex, follow">
{%- endif -%}

{%- if block.settings.enable_organization -%}
  {%- assign org_name = block.settings.organization_name | default: shop.name -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ org_name | json }},
    "url": {{ request.origin | json }}
    {%- if block.settings.logo_url != blank -%}
    ,"logo": {{ block.settings.logo_url | json }}
    {%- endif -%}
    {%- assign social_count = 0 -%}
    {%- if block.settings.social_facebook != blank -%}{%- assign social_count = social_count | plus: 1 -%}{%- endif -%}
    {%- if block.settings.social_instagram != blank -%}{%- assign social_count = social_count | plus: 1 -%}{%- endif -%}
    {%- if block.settings.social_tiktok != blank -%}{%- assign social_count = social_count | plus: 1 -%}{%- endif -%}
    {%- if block.settings.social_x != blank -%}{%- assign social_count = social_count | plus: 1 -%}{%- endif -%}
    {%- if social_count > 0 -%}
    ,"sameAs": [
      {%- assign printed = 0 -%}
      {%- if block.settings.social_facebook != blank -%}{{ block.settings.social_facebook | json }}{%- assign printed = printed | plus: 1 -%}{%- if printed < social_count -%},{%- endif -%}{%- endif -%}
      {%- if block.settings.social_instagram != blank -%}{{ block.settings.social_instagram | json }}{%- assign printed = printed | plus: 1 -%}{%- if printed < social_count -%},{%- endif -%}{%- endif -%}
      {%- if block.settings.social_tiktok != blank -%}{{ block.settings.social_tiktok | json }}{%- assign printed = printed | plus: 1 -%}{%- if printed < social_count -%},{%- endif -%}{%- endif -%}
      {%- if block.settings.social_x != blank -%}{{ block.settings.social_x | json }}{%- assign printed = printed | plus: 1 -%}{%- if printed < social_count -%},{%- endif -%}{%- endif -%}
    ]
    {%- endif -%}
  }
  </script>
{%- endif -%}

{%- if block.settings.enable_website_search and template == 'index' -%}
  {%- assign search_target = request.origin | append: "/search?q=" -%}
  {%- assign search_target = search_target | append: "{search_term_string}" -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "url": {{ request.origin | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": {{ search_target | json }},
      "query-input": "required name=search_term_string"
    }
  }
  </script>
{%- endif -%}

{%- if block.settings.enable_product and template contains 'product' and product -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | truncate: 5000 | json }},
    "sku": {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
    "url": {{ product.url | prepend: request.origin | json }}
    {%- if product.vendor != blank -%}
    ,"brand": { "@type": "Brand", "name": {{ product.vendor | json }} }
    {%- endif -%}
    {%- if product.featured_image -%}
    ,"image": [{{ product.featured_image | image_url: width: 1200 | prepend: "https:" | json }}]
    {%- endif -%}
    ,"offers": [
      {%- for variant in product.variants limit: 50 -%}
      {
        "@type": "Offer",
        "url": {{ product.url | append: "?variant=" | append: variant.id | prepend: request.origin | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ variant.price | divided_by: 100.0 }},
        "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
        "itemCondition": "https://schema.org/NewCondition"
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{%- if block.settings.enable_breadcrumbs and template contains 'product' and product and collection and collection.handle -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": {{ shop.name | json }}, "item": {{ request.origin | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ collection.url | prepend: request.origin | json }} },
      { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ product.url | prepend: request.origin | json }} }
    ]
  }
  </script>
{%- endif -%}

{%- if block.settings.enable_article and template contains 'article' and article -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ article.title | truncate: 110 | json }},
    "url": {{ article.url | prepend: request.origin | json }},
    "datePublished": {{ article.published_at | date: "%Y-%m-%dT%H:%M:%S%:z" | json }},
    "dateModified": {{ article.updated_at | default: article.published_at | date: "%Y-%m-%dT%H:%M:%S%:z" | json }},
    "description": {{ article.excerpt_or_content | strip_html | truncate: 300 | json }},
    "publisher": { "@type": "Organization", "name": {{ block.settings.organization_name | default: shop.name | json }} }
    {%- if article.author != blank -%}
    ,"author": { "@type": "Person", "name": {{ article.author | json }} }
    {%- endif -%}
    {%- if article.image -%}
    ,"image": [{{ article.image | image_url: width: 1200 | prepend: "https:" | json }}]
    {%- endif -%}
  }
  </script>
{%- endif -%}

{%- if block.settings.enable_local_business and template == 'index' and shop.address.city != blank -%}
  {%- assign lb_phone = block.settings.business_phone | default: shop.phone -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": {{ block.settings.business_type | default: "Store" | json }},
    "name": {{ block.settings.organization_name | default: shop.name | json }},
    "url": {{ request.origin | json }},
    {%- if lb_phone != blank -%}
    "telephone": {{ lb_phone | json }},
    {%- endif -%}
    {%- if block.settings.logo_url != blank -%}
    "image": {{ block.settings.logo_url | json }},
    {%- endif -%}
    "address": {
      "@type": "PostalAddress",
      "streetAddress": {{ shop.address.street | json }},
      "addressLocality": {{ shop.address.city | json }},
      "addressRegion": {{ shop.address.province | json }},
      "postalCode": {{ shop.address.zip | json }},
      "addressCountry": {{ shop.address.country_code | json }}
    }
  }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "SEO Schema (JSON-LD)",
  "target": "head",
  "settings": [
    {
      "type": "header",
      "content": "What to include"
    },
    {
      "type": "checkbox",
      "id": "enable_organization",
      "label": "Organization info (every page)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_product",
      "label": "Product price & availability (product pages)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_breadcrumbs",
      "label": "Breadcrumbs (product pages)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_article",
      "label": "Blog post details (blog posts)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_local_business",
      "label": "Local business (homepage)",
      "info": "Turn on if customers can visit or contact you at your store address. Uses the address in Settings > Store details.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_website_search",
      "label": "Site search box in Google (homepage)",
      "default": false
    },
    {
      "type": "header",
      "content": "Organization info"
    },
    {
      "type": "text",
      "id": "organization_name",
      "label": "Name",
      "info": "Defaults to your shop name if left blank."
    },
    {
      "type": "url",
      "id": "logo_url",
      "label": "Logo URL",
      "info": "A direct link to your logo image, e.g. from Settings > Files. Used by Google for brand results."
    },
    {
      "type": "header",
      "content": "Local business (optional)"
    },
    {
      "type": "select",
      "id": "business_type",
      "label": "Business type",
      "default": "Store",
      "options": [
        { "value": "Store", "label": "Shop (general)" },
        { "value": "ClothingStore", "label": "Clothing" },
        { "value": "ElectronicsStore", "label": "Electronics" },
        { "value": "HomeGoodsStore", "label": "Home goods" },
        { "value": "FurnitureStore", "label": "Furniture" },
        { "value": "JewelryStore", "label": "Jewellery" },
        { "value": "ShoeStore", "label": "Shoes" },
        { "value": "SportingGoodsStore", "label": "Sports" },
        { "value": "ToyStore", "label": "Toys" },
        { "value": "GroceryStore", "label": "Grocery" },
        { "value": "HealthAndBeautyBusiness", "label": "Health & beauty" }
      ]
    },
    {
      "type": "text",
      "id": "business_phone",
      "label": "Phone",
      "info": "Defaults to your store's phone number if left blank."
    },
    {
      "type": "header",
      "content": "Social profiles (optional)"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "social_x",
      "label": "X / Twitter URL"
    }
  ]
}
{% endschema %}
